# ===============================================================
# YouTube Otomasyon Sistemi - Çevre Değişkenleri Şablonu
# Bu dosyayı '.env' olarak kopyalayıp kendi bilgilerinizi girin:
# cp .env.example .env
# ===============================================================

# Google Cloud YouTube Data API v3 OAuth Dosya Yolları
# Google Cloud Console'dan indirdiğiniz OAuth masaüstü istemci dosyasının yolu:
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json

# İlk yetkilendirmeden sonra otomatik oluşturulacak token dosyası:
YOUTUBE_TOKEN_FILE=config/youtube_token.json

# Google Flow Chrome CDP Bağlantı Adresi (Varsayılan: 9222 portu)
CHROME_CDP_URL=http://127.0.0.1:9222

# İsteğe Bağlı: Görev bitiminde Telegram bildirimi almak için bildirim scripti yolu
# TELEGRAM_NOTIFIER_SCRIPT=/path/to/notify-telegram.py
